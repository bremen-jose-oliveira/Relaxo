EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# --- Preview build cloud pointer (node scripts/sync-preview-build.mjs) ---
# Easiest: service role secret (bypasses DB password / encoding issues)
# Supabase → Project Settings → API → service_role → Reveal
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Cloud schema CLI (node scripts/supabase-migrate.mjs) ---
# Check without DB login: node scripts/supabase-status.mjs
#
# Recommended: plain password + region (do NOT URL-encode the password here)
# SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
# SUPABASE_DB_REGION=eu-central-1
#
# Or paste Session mode URI (user must be postgres.<ref>, host aws-0-….pooler…):
# SUPABASE_DB_URL=postgresql://postgres.YOUR_REF:ENCODED_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#
# Do NOT use db.YOUR_REF.supabase.co — often IPv6-only from Macs.
