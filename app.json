{
  "expo": {
    "name": "Relaxo",
    "slug": "relaxo",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "relaxo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joseoliv.relaxo",
      "appleTeamId": "YJYA3WJYT5",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.joseoliv.relaxo",
      "adaptiveIcon": {
        "backgroundColor": "#0A122E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A122E"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#6B7FBF"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-localization",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.joseoliv.relaxo.widgets",
          "groupIdentifier": "group.com.joseoliv.relaxo",
          "widgets": [
            {
              "name": "SleepHomeWidget",
              "displayName": "Relaxo Sleep",
              "description": "See sleep status and start or end a nap from Home Screen or Lock Screen.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "8976219b-9c26-4481-ac57-23dc6496c341",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.joseoliv.relaxo.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.joseoliv.relaxo"
                    ]
                  }
                },
                {
                  "targetName": "RelaxoWatch",
                  "bundleIdentifier": "com.joseoliv.relaxo.watch",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.joseoliv.relaxo"
                    ]
                  }
                },
                {
                  "targetName": "RelaxoWatchWidget",
                  "bundleIdentifier": "com.joseoliv.relaxo.watch.widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.joseoliv.relaxo"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "jose_oliv",
    "runtimeVersion": "1.2.0",
    "updates": {
      "url": "https://u.expo.dev/8976219b-9c26-4481-ac57-23dc6496c341",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
